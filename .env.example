# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/sap_monitor
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# FastAPI Backend
FAST_API_HOST=0.0.0.0
FAST_API_PORT=8000
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
DEBUG=false

# Frontend React
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# SSH Monitoring Configuration
SSH_TIMEOUT=10
SSH_RETRIES=3
SSH_PARALLEL_WORKERS=10
SSH_PORT=22

# AI/LLM Configuration
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama2
OLLAMA_TEMPERATURE=0.7
OLLAMA_TIMEOUT=30

# Redis Cache
REDIS_URL=redis://redis:6379/0
REDIS_EXPIRE_TIME=3600

# Scheduler
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_MAX_INSTANCES=1

# Alerts & Notifications
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_SERVER=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=noreply@company.com
ALERT_TEAMS_WEBHOOK_URL=
ALERT_SLACK_WEBHOOK_URL=

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/sap-monitor/app.log

# Data Retention
METRIC_RETENTION_DAYS=30
AUDIT_LOG_RETENTION_DAYS=90

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
